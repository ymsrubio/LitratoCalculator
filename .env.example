# Copy this file to .env.local and fill it in by running:
#   ./scripts/provision.sh
#
# Don't hand-fill this by copying it to .env.local yourself — the script
# walks you through the Neon and Google Cloud dashboards, captures each
# value as you paste it, and writes it to .env.local for you. Re-running
# the script is safe: it detects values you already have and offers to
# keep them instead of creating duplicate cloud resources.
#
# .env.local is covered by .gitignore and must never be committed.
# See docs/provisioning.md for where each value comes from and how to
# rotate it later.

# ── Neon Postgres (docs/adr/0001-neon-postgres-with-rls.md) ───────────────
# Full connection string, for a human or CI to run migrations by hand.
# The deployed app never uses this directly — it talks to Neon through the
# Data API below, authorizing with the signed-in user's Neon Auth JWT.
DATABASE_URL=
NEON_PROJECT_ID=
# Public REST endpoint the browser calls directly. Safe to expose (VITE_
# vars are inlined into the client bundle by Vite).
VITE_NEON_DATA_API_URL=

# ── Neon Auth / Google sign-in (docs/adr/0002-neon-auth-google-only.md) ───
VITE_NEON_AUTH_PROJECT_ID=
VITE_NEON_AUTH_PUBLISHABLE_KEY=
# Server/admin key. Never prefix a secret with VITE_ — that would ship it
# to every browser. Not read by app code today; kept for rotation records.
NEON_AUTH_SECRET_KEY=

# Google Cloud OAuth client wired into Neon Auth's Google provider.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# The redirect URI(s) registered on the Google OAuth client for each
# environment (Neon Auth's setup screen shows you the exact value(s) to use).
GOOGLE_OAUTH_REDIRECT_URI_LOCAL=
GOOGLE_OAUTH_REDIRECT_URI_PROD=
